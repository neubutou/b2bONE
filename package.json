{
  "name": "b2bone-salesforce-portal",
  "version": "1.0.0",
  "description": "B2B Portal mit Salesforce-Supabase Synchronisation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "sync": "npm run sync --workspace=packages/salesforce-sync",
    "db:setup": "cd supabase && supabase start",
    "db:migrate": "cd supabase && supabase db push",
    "db:reset": "cd supabase && supabase db reset"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
